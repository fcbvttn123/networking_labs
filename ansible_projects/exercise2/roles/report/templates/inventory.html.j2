<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Network Inventory Report</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      color: #222;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      margin-bottom: 28px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 10px;
      text-align: left;
    }
    th {
      background: #edf2f7;
    }
    h1, h2 {
      color: #243b53;
    }
    .up {
      color: #18794e;
    }
    .down {
      color: #b42318;
    }
  </style>
</head>
<body>
  <h1>Network Inventory Report</h1>
  <p>Generated by Ansible.</p>

  <h2>Device Inventory</h2>
  <table>
    <thead>
      <tr>
        <th>Device</th>
        <th>Hostname</th>
        <th>Management IP</th>
        <th>Model</th>
        <th>IOS Version</th>
        <th>Serial Number</th>
      </tr>
    </thead>
    <tbody>
      {% for device in groups['ios'] %}
      {% set facts = hostvars[device] %}
      <tr>
        <td>{{ device }}</td>
        <td>{{ facts.ansible_net_hostname | default('Unknown') }}</td>
        <td>{{ facts.ansible_host | default('Unknown') }}</td>
        <td>{{ facts.ansible_net_model | default('Unknown') }}</td>
        <td>{{ facts.ansible_net_version | default('Unknown') }}</td>
        <td>{{ facts.ansible_net_serialnum | default('Unknown') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Interface Inventory</h2>

  {% for device in groups['ios'] %}
  {% set facts = hostvars[device] %}

  <h3>{{ facts.ansible_net_hostname | default(device) }}</h3>

  <table>
    <thead>
      <tr>
        <th>Interface</th>
        <th>Operational Status</th>
        <th>Line Protocol</th>
        <th>IPv4 Address</th>
      </tr>
    </thead>
    <tbody>
      {% for interface, details in
         (facts.ansible_net_interfaces | default({})).items() %}
      <tr>
        <td>{{ interface }}</td>
        <td>{{ details.get('operstatus', 'Unknown') }}</td>
        <td>{{ details.get('lineprotocol', 'Unknown') }}</td>
        <td>
          {{ details.get('ipv4', {}).get('address', 'N/A') }}
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="4">No interface facts returned.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</body>
</html>